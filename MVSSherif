local function requireAny(paths, default)
    for _, path in ipairs(paths) do
        local success, res = pcall(function()
            local cur = services.replicatedStorage
            for i, p in ipairs(path) do cur = cur:WaitForChild(p, 1) or cur:FindFirstChild(p); if not cur then error("not found") end end
            return require(cur)
        end)
        if success and res then return res end
    end
    return default
end
