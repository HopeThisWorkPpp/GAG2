                    local currentCamera = workspace.CurrentCamera
                    local value = (currentCamera and (currentCamera.CFrame.Position - humanoidRootPart.Position).Magnitude) or 9999
                    if value <= maxAimDistance then
                        local score = scoreTarget(enemy)
                        if (score > 20) and (score > n) then
