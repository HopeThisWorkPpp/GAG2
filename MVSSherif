    if (now - lastShotTime) < minShotInterval then
        return false
    end
    local character = localPlayer.Character
    if not character or not character:IsDescendantOf(workspace) then
        return false
    end
    local character2 = targetPlayer.Character
    if not character2 or not character2:IsDescendantOf(workspace) then
        return false
    end
    local value = getCachedChild(character, "HumanoidRootPart") or character:FindFirstChild("Head")
    local humanoidRootPart = getCachedChild(character2, "HumanoidRootPart")
    local humanoid = getCachedChild(character2, "Humanoid")
    if not value or not humanoidRootPart or not humanoid or (humanoid.Health <= 0) then
        return false
    end
    local magnitude = (value.Position - humanoidRootPart.Position).Magnitude
    if magnitude > maxAimDistance then
        return false
    end
    local inFront = isInFrontOfCamera(humanoidRootPart.Position)
    if not inFront and not aimSettings.allowBackwardsShooting then
        return false
    end
    local rayCount = getRaycastCount(magnitude)
    local canHit, hitRatio = canHitTarget(character2, value.Position, rayCount)
