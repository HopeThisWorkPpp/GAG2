function formatSuffix(val)
    local suffixes = {"", "K", "M", "B", "T", "QD", "QN", "SX", "SP", "O", "N", "D", "UD", "DD"}
    local i = 1
    while val >= 1000 and i < #suffixes do val = val / 1000; i = i + 1 end
    return i == 1 and tostring(val) or string.format("%.2f%s", val, suffixes[i]):gsub("%.00", "")
end

