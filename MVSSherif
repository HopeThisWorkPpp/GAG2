-- 1. SAFE REMOTE SHIM
local RemoteServices = services.replicatedStorage:WaitForChild("RemoteServices")
local function rem(svc, kind, name)
    local s = RemoteServices:FindFirstChild(svc); if not s then return nil end
    local f = s:FindFirstChild(kind); if not f then return nil end
    return f:FindFirstChild(name)
end
local remotes = {
    TapRequested = rem("TapService", "RE", "TapRequested"), RebirthRequested = rem("RebirthService", "RE", "RebirthRequested"), TradeRequested = rem("TradingService", "RE", "TradeRequested"), EggHatchRequested = rem("EggService", "RE", "EggHatchRequested"), MachineCraftRequested = rem("MachineService", "RE", "MachineCraftRequested"), WorldTravel = rem("WorldService", "RF", "Travel"), Spin = rem("EventWheelService", "RF", "Spin"), Enchant = rem("EnchantService", "RF", "Enchant"), PotionBuy = rem("PotionMachineService", "RF", "Buy"), ClaimReward = rem("LeaderboardService", "RF", "ClaimReward"), DigBegin = rem("DigService", "RF", "Begin"), DigHit = rem("DigService", "RF", "Hit"), AutoDeleteRequested = rem("EggService", "RE", "AutoDeleteRequested")
}
local function makeNetworkShim()
    local fire = { Tap = function(...) return remotes.TapRequested and remotes.TapRequested:FireServer(...) end, Rebirth = function(...) return remotes.RebirthRequested and remotes.RebirthRequested:FireServer(...) end, OpenEgg = function(...) return remotes.EggHatchRequested and remotes.EggHatchRequested:FireServer(...) end, CraftPets = function(...) return remotes.MachineCraftRequested and remotes.MachineCraftRequested:FireServer(...) end, StartRainbow = function(...) return remotes.MachineCraftRequested and remotes.MachineCraftRequested:FireServer(...) end, ClaimRainbow = function(...) return remotes.MachineCraftRequested and remotes.MachineCraftRequested:FireServer(...) end, DeletePet = function(...) return remotes.AutoDeleteRequested and remotes.AutoDeleteRequested:FireServer(...) end }
    local invoke = { TeleportWorld = function(w) return remotes.WorldTravel and remotes.WorldTravel:InvokeServer(w) end, TeleportZone = function(z) return remotes.WorldTravel and remotes.WorldTravel:InvokeServer(z) end, EnchantPet = function(id) return remotes.Enchant and remotes.Enchant:InvokeServer(id) end, SpinWheel = function() return remotes.Spin and remotes.Spin:InvokeServer() end, StartMinigame = function(g) return remotes.DigBegin and remotes.DigBegin:InvokeServer(g) end, FinishMinigame = function(g) return remotes.DigHit and remotes.DigHit:InvokeServer(g) end, BuyPotionMachine = function(a) return remotes.PotionBuy and remotes.PotionBuy:InvokeServer(a) end, ClaimRankReward = function() return remotes.ClaimReward and remotes.ClaimReward:InvokeServer() end }
    return { FireServer = function(_, n, ...) local f = fire[n]; if f then return f(...) end end, InvokeServer = function(_, n, ...) local f = invoke[n]; if f then return f(...) end end }
end

-- 2. DATA LOADERS
local ReplicaController = nil
pcall(function() ReplicaController = require(services.replicatedStorage.Controllers.Core.ReplicaController) end)
local function getReplicaData()
    if not ReplicaController or not ReplicaController._replicas then return nil end
    for _, r in pairs(ReplicaController._replicas) do if r.Class == "PlayerData" then return r.Data end end
    return nil
end
local function getPets(data) if not data or not data.Pets then return {} end local p = data.Pets.Owned or data.Pets; if type(p) ~= "table" then return {} end local v = {} for k, val in pairs(p) do if type(val) == "table" then v[k] = val end end return v end

