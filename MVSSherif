-- DYNAMIC UI UPDATE
task.spawn(function()
    local s = tick(); repeat task.wait() until (player.replication.Loaded and player.replication.Data) or (tick() - s > 10)
    if player.replication.Data then
        local norm, gold, all, pMap = {}, {}, {}, {}
        for id, d in pairs(getPets(player.replication.Data)) do
            if d.Tier == "Normal" and not norm[d.Name] then norm[d.Name] = true end
            if d.Tier == "Golden" and not gold[d.Name] then gold[d.Name] = true end
            all[d.Tier.." - "..d.Name] = true
        end
        local function getKeys(t) local r = {} for k in pairs(t) do table.insert(r, k) end table.sort(r) return r end
        pcall(function() tabs.crafting:GetElement("Select Normal Pets"):Refresh(getKeys(norm)) end)
        pcall(function() tabs.crafting:GetElement("Select Golden Pets"):Refresh(getKeys(gold)) end)
        pcall(function() tabs.misc:GetElement("Select Pets"):Refresh(getKeys(all)) end)
        local plist = {}
        for id, d in pairs(getPets(player.replication.Data)) do local str = d.Name.." ("..(d.Enchant ~= "" and d.Enchant or "None")..")"; table.insert(plist, str); pMap[str] = id end
        tabs.enchanting.petMap = pMap
        pcall(function() tabs.enchanting:GetElement("Pets to Enchant"):Refresh(plist) end)
    end
end)

WindUI:Notify({Title = "Silence V3", Content = "Script loaded successfully!"})
