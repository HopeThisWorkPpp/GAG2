addToggle(tabs.misc, "Auto Delete", "lucide:trash-2", function(s) if s then tabs.misc.loop = task.spawn(function() while true do if tabs.misc.del then local start = tick(); repeat task.wait() until (player.replication.Loaded and player.replication.Data) or (tick() - start > 5); if player.replication.Data then for id, d in pairs(getPets(player.replication.Data)) do if not d.Locked then for _, n in ipairs(tabs.misc.del) do if d.Name == n then pcall(function() player.network:InvokeServer("DeletePet", id) end); task.wait(0.2) end end end end end; task.wait(1) end end) else if tabs.misc.loop then task.cancel(tabs.misc.loop); tabs.misc.loop = nil end end end)

