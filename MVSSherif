-- MOBILE LOCK-ON AIMBOT
-- No metatable hooks, no remote event spam.
-- Moves the actual camera to point at the target.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

-- ══════════════════════════════════════════════
--  CONFIGURATION
-- ══════════════════════════════════════════════
local MAX_DISTANCE = 200      -- Max studs to lock onto
local FOV = 120               -- Screen-space FOV (pixels from center)
local SMOOTHNESS = 0.25       -- 0 = instant snap, 1 = never move
local AIM_PART = "Head"       -- "Head" or "HumanoidRootPart"

local locked = false
local currentTarget = nil

-- ══════════════════════════════════════════════
--  HELPER FUNCTIONS
-- ══════════════════════════════════════════════
local function getLocalRoot()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function isEnemy(player)
    if player == LocalPlayer then return false end
    local myTeam = LocalPlayer:GetAttribute("Team")
    local theirTeam = player:GetAttribute("Team")
    return theirTeam ~= myTeam
end

local function hasLineOfSight(targetChar)
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
    if not myRoot or not targetRoot then return false end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { myChar, targetChar }

    local result = Workspace:Raycast(myRoot.Position, targetRoot.Position - myRoot.Position, params)
    return result == nil
end

local function getClosestTarget()
    local myRoot = getLocalRoot()
    if not myRoot then return nil end

    local viewportCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local bestTarget, bestDist = nil, math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if isEnemy(player) then
            local char = player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and root then
                local worldDist = (root.Position - myRoot.Position).Magnitude
                if worldDist <= MAX_DISTANCE and hasLineOfSight(char) then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
                    if onScreen then
                        local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - viewportCenter).Magnitude
                        if screenDist <= FOV and screenDist < bestDist then
                            bestDist = screenDist
                            bestTarget = player
                        end
                    end
                end
            end
        end
    end
    return bestTarget
end

local function getAimPosition(player)
    local char = player.Character
    if not char then return nil end
    local part = char:FindFirstChild(AIM_PART) or char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
    return part and part.Position or nil
end

-- ══════════════════════════════════════════════
--  CAMERA LOCK LOGIC
-- ══════════════════════════════════════════════
local function updateLock()
    if not locked then
        currentTarget = nil
        return
    end

    if not currentTarget or not currentTarget.Character or not currentTarget.Character:FindFirstChild("Humanoid") or currentTarget.Character.Humanoid.Health <= 0 then
        currentTarget = getClosestTarget()
    end

    if not currentTarget then
        locked = false
        return
    end

    local aimPos = getAimPosition(currentTarget)
    if not aimPos then
        locked = false
        return
    end

    local goalCFrame = CFrame.new(Camera.CFrame.Position, aimPos)
    if SMOOTHNESS <= 0 then
        Camera.CFrame = goalCFrame
    else
        Camera.CFrame = Camera.CFrame:Lerp(goalCFrame, 1 - SMOOTHNESS)
    end
end

RunService.RenderStepped:Connect(updateLock)

-- ══════════════════════════════════════════════
--  MOBILE UI: DRAGGABLE "LOCK" BUTTON
-- ══════════════════════════════════════════════
local playerGui = LocalPlayer:WaitForChild("PlayerGui")
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "MobileAimbotUI"
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

local button = Instance.new("TextButton")
button.Name = "LockButton"
button.Size = UDim2.new(0, 80, 0, 80)
button.Position = UDim2.new(1, -100, 0.5, -40) -- right side of screen
button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
button.BackgroundTransparency = 0.2
button.TextColor3 = Color3.fromRGB(255, 255, 255)
button.Font = Enum.Font.GothamBold
button.TextSize = 20
button.Text = "LOCK"
button.BorderSizePixel = 0
button.Parent = screenGui

-- Rounded corners
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = button

-- Toggle logic
button.MouseButton1Click:Connect(function()
    locked = not locked
    if locked then
        currentTarget = getClosestTarget()
        button.BackgroundColor3 = Color3.fromRGB(0, 200, 100) -- green when active
        button.Text = "UNLOCK"
    else
        button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        button.Text = "LOCK"
        currentTarget = nil
    end
end)

-- Dragging logic (works on mobile)
local dragging, dragInput, dragStart, startPos
button.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = button.Position
    end
end)
button.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        button.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
button.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)
