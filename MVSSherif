local function canHitTarget(targetCharacter, origin, rayBudget)
    if not targetCharacter or not origin then
        return false, 0
    end
    local n = 0
    local n2 = 0
    local maxDistance = maxAimDistance
    local hitboxInfo = getHitboxInfo(targetCharacter)
    local hitboxScale = hitboxInfo.hitboxScale
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Blacklist
    rayParams.FilterDescendantsInstances = {
        localPlayer.Character,
    }
    rayParams.IgnoreWater = true
    local value = math.min(rayBudget * #targetPartNames, aimSettings.maxRaysPerFrame)
    for _, targetPartName in ipairs(targetPartNames) do
        local targetPart = targetCharacter:FindFirstChild(targetPartName)
        if targetPart and targetPart:IsA("BasePart") then
            if not takeRaySlot() or (n2 >= value) then
                break
            end
            local result = workspace:Raycast(origin, (targetPart.Position - origin).Unit * maxDistance, rayParams)
            if result and result.Instance and result.Instance:IsDescendantOf(targetCharacter) then
                n = n + 1
            end
            n2 = n2 + 1
            local value2 = math.min(rayBudget - 1, 2)
            for i = 1, value2 do
                if not takeRaySlot() or (n2 >= value) then
                    break
                end
                local vec = Vector3.new((math.random() - 0.5) * 0.3 * hitboxScale, (math.random() - 0.5) * 0.3 * hitboxScale, (math.random() - 0.5) * 0.3 * hitboxScale)
                local value3 = targetPart.Position + vec
                result = workspace:Raycast(origin, (value3 - origin).Unit * maxDistance, rayParams)
                if result and result.Instance and result.Instance:IsDescendantOf(targetCharacter) then
                    n = n + 1
                end
                n2 = n2 + 1
            end
        end
    end
    local value2 = ((n2 > 0) and (n / n2)) or 0
    return (n > 0) and (value2 >= 0.2), value2
end
local function scoreTarget(targetPlayer)
    local character = targetPlayer.Character
    if not character then
        return 0
    end
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then
        return 0
    end
    local currentCamera = workspace.CurrentCamera
    if not currentCamera then
        return 0
    end
    local n = 0
    local onScreen, screenPoint, angle = getScreenInfo(humanoidRootPart.Position)
    if onScreen then
        local value = 1 - (angle / aimSettings.maxCameraAngle)
        value = math.clamp(value, 0, 1)
        n = n + (value * aimSettings.screenCenterWeight * 100)
    else
        return n
    end
    local magnitude = (currentCamera.CFrame.Position - humanoidRootPart.Position).Magnitude
    if magnitude <= maxAimDistance then
        local value = 1 - (magnitude / maxAimDistance)
        n = n + (value * aimSettings.distanceWeight * 100)
    end
    local character2 = localPlayer.Character
    if character2 then
        local value = getCachedChild(character2, "HumanoidRootPart") or character2:FindFirstChild("Head")
        if value then
            local rayParams = RaycastParams.new()
            rayParams.FilterType = Enum.RaycastFilterType.Blacklist
            rayParams.FilterDescendantsInstances = {
                character2,
            }
            local result = workspace:Raycast(value.Position, (humanoidRootPart.Position - value.Position).Unit * magnitude, rayParams)
            if not result or (result.Instance and result.Instance:IsDescendantOf(character)) then
                n = n + (aimSettings.visibilityWeight * 100)
            end
        end
    end
    return n
end
local function findBestTarget()
    local bestTarget
    local enemies = getEnemyPlayers()
    if not enemies or (type(enemies) ~= "table") or (#enemies == 0) then
