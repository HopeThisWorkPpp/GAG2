            if value2 > 4 then
                local value3 = value2 - 4
                for i = 1, value3 do
                    if tbl2[i] then
                        tbl2[i]:Destroy()
                    end
                end
            elseif (value2 < 4) then
                local value3 = 4 - value2
                for i = 1, 4 do
