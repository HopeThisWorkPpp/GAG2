-- 6. Load Data in Background & Update UI
task.spawn(function()
    local s = tick(); repeat task.wait(0.5) until (player.replication.Loaded and player.replication.Data) or (tick() - s > 10)
    if not player.replication.Data then return end

    -- Rebirths
    local rebValues = {}
    pcall(function()
        for i = player.replication.Data.RebirthOptions or 0, 1, -1 do
            local amt = (player.rebirths and player.rebirths.fromIndex) and player.rebirths:fromIndex(i) or 1
            local price = (player.rebirths and player.rebirths.getPrice) and player.rebirths:getPrice(amt) or 1
            local clicks = (player.rebirths and player.rebirths.ClicksPrice) and player.rebirths:ClicksPrice(price, player.replication.Data.Statistics.Rebirths or 0) or 1
            local txt = string.format("%d. +%s (%s)", i, formatSuffix(amt), formatSuffix(clicks))
            table.insert(rebValues, txt)
            ui.rebMap[txt] = {index = i}
        end
    end)
    if #rebValues > 0 then pcall(function() ui.rebDropdown:Refresh(rebValues) end) else pcall(function() ui.rebDropdown:Refresh({"None"}) end) end

    -- Eggs
    local eggs = {}
    pcall(function()
        local folder = services.workspace:FindFirstChild("Eggs")
        if folder then
            for n, d in pairs(player.eggs) do
                if type(d) == "table" and not d.Currency and d.Price and d.Price > 0 and folder:FindFirstChild(n) then table.insert(eggs, {name=n, price=d.Price}) end
            end
        end
    end)
    table.sort(eggs, function(a,b) return a.price < b.price end)
    local eggList = {}
    for _, e in ipairs(eggs) do table.insert(eggList, string.format("%s - %s", e.name, formatSuffix(e.price))) end
    if #eggList > 0 then pcall(function() ui.eggDropdown:Refresh(eggList) end) else pcall(function() ui.eggDropdown:Refresh({"None"}) end) end

    -- Pets
    local norm, gold, all, enchNames = {}, {}, {}, {}
    pcall(function()
        for id, d in pairs(getPets(player.replication.Data)) do
            if d.Tier == "Normal" and not norm[d.Name] then norm[d.Name] = true end
            if d.Tier == "Golden" and not gold[d.Name] then gold[d.Name] = true end
            all[d.Tier.." - "..d.Name] = true
        end
    end)
    local function getKeys(t) local r = {} for k in pairs(t) do table.insert(r, k) end table.sort(r) return r end
    local nList, gList, aList = getKeys(norm), getKeys(gold), getKeys(all)
    pcall(function() ui.goldPetsDropdown:Refresh(#nList > 0 and nList or {"None"}) end)
    pcall(function() ui.rainPetsDropdown:Refresh(#gList > 0 and gList or {"None"}) end)
    pcall(function() ui.delPetsDropdown:Refresh(#aList > 0 and aList or {"None"}) end)

    -- Enchants
    pcall(function()
        for n, _ in pairs(player.enchantData.Enchants or {}) do table.insert(enchNames, n) end
        table.sort(enchNames)
        ui.enchDropdown:Refresh(#enchNames > 0 and enchNames or {"None"})
        local plist = {}
        for id, d in pairs(getPets(player.replication.Data)) do local str = d.Name.." ("..(d.Enchant ~= "" and d.Enchant or "None")..")"; table.insert(plist, str); ui.enchMap[str] = id end
        ui.enchPetsDropdown:Refresh(#plist > 0 and plist or {"None"})
    end)
    
    -- Teleports
    pcall(function()
        local zones = {}
        for n, d in pairs(player.portals) do 
            if type(d) == "table" and d.Price and not ({Kryo=1,Magma=1,Celestial=1,Holographic=1,Lunar=1,Cyberpunk=1,Rainbow=1})[n] then 
                table.insert(zones, {name=n, price=d.Price}) 
            end 
        end
        table.sort(zones, function(a,b) return a.price < b.price end)
        for _, z in ipairs(zones) do 
            tabs.teleport:Button({ Title = "Teleport to " .. z.name, Callback = function() pcall(function() player.network:InvokeServer("TeleportZone", z.name) end) end }) 
        end
        for _, z in ipairs({{name="Kryo"},{name="Magma"},{name="Celestial"},{name="Holographic"},{name="Lunar"},{name="Cyberpunk"},{name="Rainbow"}}) do 
            tabs.teleport:Button({ Title = "Teleport to " .. z.name, Callback = function() pcall(function() player.network:InvokeServer("TeleportZone", z.name) end) end }) 
        end
    end)
end)

