    end
    return redFrame, blueFrame
end
local function getFrameNames2(frame)
    local tbl = {}
    for _, child in ipairs(frame:GetChildren()) do
        if child:IsA("Frame") then
            table.insert(tbl, child.Name)
        end
    end
    return tbl
end
local function getEspTargets()
    local redFrame, blueFrame = getTeamFrames2()
    if not redFrame or not blueFrame then
        return nil, nil
    end
    local redNames = getFrameNames2(redFrame)
    local blueNames = getFrameNames2(blueFrame)
    local flag, flag2 = false, false
    local tbl, tbl2 = {}, {}
    for _, redName in ipairs(redNames) do
        local name = stripEspSuffix(redName)
        tbl[name] = true
        if name == localPlayer.Name then
            flag = true
        end
    end
    for _, blueName in ipairs(blueNames) do
        local name = stripEspSuffix(blueName)
        tbl2[name] = true
        if name == localPlayer.Name then
            flag2 = true
        end
    end
    if not flag and not flag2 then
        return nil, nil
    end
    local color, nameSet = nil
    if flag then
        nameSet = tbl2
        color = Color3.fromRGB(0, 0, 255)
    else
        nameSet = tbl
        color = Color3.fromRGB(255, 0, 0)
    end
    local tbl3 = {}
    for key, _ in pairs(nameSet) do
        local targetPlayer = Players:FindFirstChild(key)
        if targetPlayer and (targetPlayer ~= localPlayer) then
            table.insert(tbl3, targetPlayer)
        end
    end
    return tbl3, color
end
local function refreshEsp()
    if not espEnabled then
        return
    end
    local targets, color = getEspTargets()
    if not targets or not color then
        for key, _ in pairs(espHighlights) do
            removeHighlight(key)
        end
        return
    end
    for key, _ in pairs(espHighlights) do
        local flag = table.find(targets, key) ~= nil
        if not flag then
            removeHighlight(key)
        end
    end
    for _, target in ipairs(targets) do
        applyHighlight(target, color)
    end
end
