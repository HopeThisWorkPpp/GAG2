local function startInvisibility()
    if invisibilityConnection then
        invisibilityConnection:Disconnect()
        invisibilityConnection = nil
    end
    local bodyVelocity = character:FindFirstChild("HumanoidRootPart"):FindFirstChild("BodyVelocity")
    if bodyVelocity then
        bodyVelocity.P = 0
        bodyVelocity.MaxForce = Vector3.new(0, 0, 0)
    end
    clone = character:Clone()
    for _, descendant in pairs(clone:GetDescendants()) do
        if descendant:IsA("BodyVelocity") or descendant:IsA("BodyGyro") or descendant:IsA("BodyPosition") then
            descendant:Destroy()
        end
        if descendant:IsA("BasePart") and (descendant.Transparency < 1) then
            descendant.Transparency = 0.85
        end
    end
    local bodyVelocity2 = Instance.new("BodyVelocity")
    bodyVelocity2.MaxForce = Vector3.new(500000, 500000, 500000)
    bodyVelocity2.Velocity = Vector3.new(0, 0, 0)
    bodyVelocity2.Parent = clone.HumanoidRootPart
    clone.Parent = workspace
    clone.HumanoidRootPart.CFrame = character.HumanoidRootPart.CFrame
    clone.Humanoid.WalkSpeed = character.Humanoid.WalkSpeed * 2
    clone.HumanoidRootPart.Anchored = false
    local animator = character:FindFirstChildOfClass("Animator")
    if animator then
        animator:Clone().Parent = clone
    end
    for _, child in pairs(character:GetChildren()) do
        if child:IsA("LocalScript") then
            local scriptClone = child:Clone()
            scriptClone.Disabled = true
            scriptClone.Parent = clone
        end
    end
    workspace.CurrentCamera.CameraSubject = clone.Humanoid
    isInvisible = true
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local value = character.HumanoidRootPart.CFrame + Vector3.new(0, 100000000, 0)
    task.spawn(function()
        for i = 1, 90 do
            if isInvisible then
                character.HumanoidRootPart.CFrame = value
            end
            task.wait(0.1)
        end
    end)
    task.wait(0.1)
    invisibilityConnection = RunService.RenderStepped:Connect(function()
        if not _G.InvisibilityEnabled then
            return
        end
        if not isInvisible then
            return
        end
        local moveDirection = humanoid.MoveDirection
        if moveDirection.Magnitude > 0 then
            bodyVelocity2.Parent = nil
            local currentCamera = workspace.CurrentCamera
            local lookVector = currentCamera.CFrame.LookVector
            local flag = lookVector:Dot(moveDirection) < 0
            local value2 = (flag and (lookVector.Y * -1.4)) or (lookVector.Y * 1.8)
            local value3 = (flag and 1.4) or 1.6
            local unit = Vector3.new(moveDirection.X, value2 + 0.35, moveDirection.Z).Unit
            clone.HumanoidRootPart.Velocity = unit * clone.Humanoid.WalkSpeed * value3
        else
            bodyVelocity2.Parent = clone.HumanoidRootPart
        end
    end)
end
local function stopInvisibility()
    if not isInvisible then
        return
    end
    character.HumanoidRootPart.Velocity = Vector3.new()
    for _, descendant in pairs(clone:GetDescendants()) do
        if descendant:IsA("BasePart") and (descendant.Transparency < 1) then
            descendant.Transparency = 1
        end
    end
    isInvisible = false
    for i = 1, 5 do
        character.HumanoidRootPart.CFrame = clone.HumanoidRootPart.CFrame
        task.wait()
    end
    clone:Destroy()
    workspace.CurrentCamera.CameraSubject = character.Humanoid
    if invisibilityConnection then
        invisibilityConnection:Disconnect()
        invisibilityConnection = nil
    end
end
