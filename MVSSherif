local function getTeamFrames()
    local ok, redFrame, blueFrame = pcall(function()
        local playerGui2 = localPlayer:FindFirstChildOfClass("PlayerGui")
        if not playerGui2 then
            return nil, nil
        end
        local main = playerGui2:FindFirstChild("Main")
        if not main then
            return nil, nil
        end
        local mainGameFrame = main:FindFirstChild("MainGameFrame")
        if not mainGameFrame then
            return nil, nil
        end
        local playersFrame = mainGameFrame:FindFirstChild("PlayersFrame")
        if not playersFrame then
            return nil, nil
        end
        return playersFrame:FindFirstChild("TeamRedFrame"), playersFrame:FindFirstChild("TeamBlueFrame")
    end)
    if not ok or not redFrame or not blueFrame then
        return nil, nil
    end
    return redFrame, blueFrame
end
local function getFrameNames(frame)
    local tbl = {}
    for _, child in ipairs(frame:GetChildren()) do
        if child:IsA("Frame") then
            table.insert(tbl, child.Name)
        end
    end
    return tbl
end
local function stripSpaces(value)
    return tostring(value):gsub("%s+", "")
end
local function getEnemyPlayers()
    local redFrame, blueFrame = getTeamFrames()
    if not redFrame or not blueFrame then
        return {}
    end
    local redNames = getFrameNames(redFrame)
    local blueNames = getFrameNames(blueFrame)
    local flag, flag2 = false, false
    local tbl, tbl2 = {}, {}
    for _, redName in ipairs(redNames) do
        local name = stripSpaces(redName)
        tbl[name] = true
        if name == stripSpaces(localPlayer.Name) then
            flag = true
        end
    end
    for _, blueName in ipairs(blueNames) do
        local name = stripSpaces(blueName)
        tbl2[name] = true
        if name == stripSpaces(localPlayer.Name) then
            flag2 = true
        end
    end
    if not (flag or flag2) then
        return {}
    end
    local value = (flag and tbl2) or tbl
    local tbl3 = {}
    for key, _ in pairs(value) do
        for _, plr in ipairs(Players:GetPlayers()) do
            if (stripSpaces(plr.Name) == key) and (plr ~= localPlayer) then
                table.insert(tbl3, plr)
            end
        end
    end
    return tbl3
end
