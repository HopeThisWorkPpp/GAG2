local function removeHighlight(targetPlayer)
    local targetPlayer2 = espHighlights[targetPlayer]
    if targetPlayer2 then
        pcall(function()
            targetPlayer2:Destroy()
        end)
        espHighlights[targetPlayer] = nil
    end
end
local function applyHighlight(targetPlayer, color)
    local character2 = targetPlayer.Character
    if not character2 then
        return
    end
    if not character2:FindFirstChild("HumanoidRootPart") then
        return
    end
    local targetPlayer2 = espHighlights[targetPlayer]
    if not targetPlayer2 or (targetPlayer2.Parent == nil) or (targetPlayer2.Adornee ~= character2) then
        if targetPlayer2 then
            pcall(function()
                targetPlayer2:Destroy()
            end)
        end
        targetPlayer2 = Instance.new("Highlight")
        targetPlayer2.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        targetPlayer2.FillTransparency = 0.5
        targetPlayer2.OutlineColor = Color3.fromRGB(255, 255, 255)
