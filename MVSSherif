addToggle(tabs.webhook, "Enable Pet Logger", "lucide:link", function(s) if s then tabs.webhook.conn = player.remotes.EggHatchResult.OnClientEvent:Connect(function(egg, pets) if type(pets) ~= "table" then return end; local send = false; local fields = {}; for _, p in ipairs(pets) do local r = "Unknown"; pcall(function() r = player.petStats:GetRarity(p[1], true) end); for _, sel in ipairs(tabs.webhook.rarities) do if sel == r then send = true end end; table.insert(fields, {name="🐾 "..p[1], value="Rarity: "..r, inline=true}) end; if send and tabs.webhook.url ~= "" then local req = (syn and syn.request) or (http and http.request) or request; pcall(function() req({Url=tabs.webhook.url, Method="POST", Headers={["Content-Type"]="application/json"}, Body=game:GetService("HttpService"):JSONEncode({content=tabs.webhook.discordId ~= "" and "<@"..tabs.webhook.discordId..">" or "", embeds={{title="Hatched from "..egg, fields=fields, color=0x00FF00}}})}) end) end end) else if tabs.webhook.conn then tabs.webhook.conn:Disconnect(); tabs.webhook.conn = nil end end end)

