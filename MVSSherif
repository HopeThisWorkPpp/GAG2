    for _, enemy in ipairs(enemies) do
        if enemy and (typeof(enemy) == "Instance") and enemy:IsA("Player") then
            local character2 = enemy.Character
            if character2 and character2:IsDescendantOf(workspace) then
                local humanoidRootPart = getCachedChild(character2, "HumanoidRootPart")
                local humanoid = getCachedChild(character2, "Humanoid")
